{
  "name": "lecture-notes",
  "version": "0.1.0",
  "description": "강의 녹음을 요약·키워드·전사문 마크다운 노트로 만드는 PC 앱",
  "author": "LeeJeongho",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/**/*.test.ts\"",
    "cli": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli/cli.ts",
    "dist:win": "electron-vite build && node scripts/notices.mjs && electron-builder --win"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.2",
    "markdown-it-cjk-friendly": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
